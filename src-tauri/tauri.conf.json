{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panes",
  "version": "0.66.0",
  "identifier": "com.panes.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "node scripts/build-desktop.mjs",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "create": false,
        "title": "Panes",
        "width": 1460,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "script-src": "'self' 'wasm-unsafe-eval' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' data: blob: https: http:",
        "font-src": "'self' data: http://localhost:1420",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421",
        "worker-src": "'self' http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "nsis"],
    "resources": ["sidecar-dist"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/com.panes.app.desktop": "linux/com.panes.app.desktop"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "files": {
        "Library/LaunchDaemons/com.panes.app.helper.keepawake.plist": "helper/com.panes.app.helper.keepawake.plist"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://wygoralves.github.io/panes/latest.json"],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBQUU2N0M2QTgyNjZBNjgKUldSb2FpYW94bWV1cXVZeko4bjl6a1c0YlROWlcwVnFZTnI5UnM1OE00cmhOQm1tY0JLRStBelAK"
    }
  }
}
